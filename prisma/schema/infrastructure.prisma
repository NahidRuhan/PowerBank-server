model DistributionZone {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  substations Substation[]

  @@index([code])
}

model Substation {
  id         String    @id @default(cuid())
  name       String
  code       String    @unique
  capacityMW Float
  zoneId     String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  zone    DistributionZone @relation(fields: [zoneId], references: [id])
  feeders Feeder[]

  @@index([zoneId])
  @@index([code])
}

model Feeder {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  loadMW       Float
  status       FeederStatus @default(ENERGIZED)
  substationId String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  substation Substation        @relation(fields: [substationId], references: [id])
  areas      Area[]
  schedules  ScheduledOutage[]
  incidents  OutageIncident[]

  @@index([substationId])
  @@index([code])
  @@index([status])
}

model Area {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  feederId      String
  priority      Priority  @default(MEDIUM)
  customerCount Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  feeder Feeder @relation(fields: [feederId], references: [id])
  users  User[]
  bills  Bill[]

  @@index([feederId])
  @@index([priority])
}
