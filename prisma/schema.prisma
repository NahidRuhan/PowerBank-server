generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum FeederStatus {
  ENERGIZED
  LOAD_SHED
  FAULT
  MAINTENANCE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  phoneNumber String?   @unique
  password    String?
  name        String
  avatar      String?
  role        Role      @default(CUSTOMER)
  meterNumber String?   @unique
  areaId      String?
  googleId    String?   @unique
  isVerified  Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  area             Area?             @relation(fields: [areaId], references: [id])
  auditLogs        AuditLog[]
  createdQuotas    SheddingQuota[]
  createdSchedules ScheduledOutage[]
  outageIncidents  OutageIncident[]
  bills            Bill[]
  payments         Payment[]

  @@index([email])
  @@index([role])
  @@index([meterNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model DistributionZone {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  substations Substation[]

  @@index([code])
}

model Substation {
  id         String    @id @default(cuid())
  name       String
  code       String    @unique
  capacityMW Float
  zoneId     String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  zone    DistributionZone @relation(fields: [zoneId], references: [id])
  feeders Feeder[]

  @@index([zoneId])
  @@index([code])
}

model Feeder {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  loadMW       Float
  status       FeederStatus @default(ENERGIZED)
  substationId String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  substation Substation        @relation(fields: [substationId], references: [id])
  areas      Area[]
  schedules  ScheduledOutage[]
  incidents  OutageIncident[]

  @@index([substationId])
  @@index([code])
  @@index([status])
}

model Area {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  feederId      String
  priority      Priority  @default(MEDIUM)
  customerCount Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  feeder Feeder @relation(fields: [feederId], references: [id])
  users  User[]
  bills  Bill[]

  @@index([feederId])
  @@index([priority])
}

enum ScheduleStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model SheddingQuota {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  timeSlot  String
  targetMW  Float
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User              @relation(fields: [createdBy], references: [id])
  schedules ScheduledOutage[]

  @@unique([date, timeSlot])
  @@index([date])
}

model ScheduledOutage {
  id        String         @id @default(cuid())
  feederId  String
  quotaId   String?
  startTime DateTime
  endTime   DateTime
  reason    String
  status    ScheduleStatus @default(SCHEDULED)
  createdBy String
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  feeder  Feeder         @relation(fields: [feederId], references: [id])
  quota   SheddingQuota? @relation(fields: [quotaId], references: [id])
  creator User           @relation(fields: [createdBy], references: [id])

  @@index([feederId, startTime, endTime])
  @@index([status])
  @@index([quotaId])
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  REPAIRING
  RESOLVED
}

model OutageIncident {
  id                   String         @id @default(cuid())
  feederId             String
  description          String
  status               IncidentStatus @default(INVESTIGATING)
  estimatedRestoration DateTime?
  resolvedAt           DateTime?
  createdBy            String
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  feeder  Feeder @relation(fields: [feederId], references: [id])
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([feederId])
  @@index([status])
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Bill {
  id           String     @id @default(cuid())
  userId       String
  areaId       String
  month        String     // "2026-09"
  amount       Float      // base amount in BDT
  surcharge    Float      @default(0)  // late fee
  totalAmount  Float      // amount + surcharge
  dueDate      DateTime
  status       BillStatus @default(UNPAID)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  area         Area       @relation(fields: [areaId], references: [id])
  payments     Payment[]

  @@unique([userId, month])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id               String        @id @default(cuid())
  billId           String
  userId           String
  amount           Float
  currency         String        @default("BDT")
  status           PaymentStatus @default(PENDING)
  stripeSessionId  String?       @unique
  stripePaymentId  String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bill             Bill          @relation(fields: [billId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([billId])
  @@index([stripeSessionId])
}
